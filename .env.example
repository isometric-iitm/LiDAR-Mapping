# Copy this file to `.env` and set paths for your machine.
# Only `.env` is gitignored; this example is committed as documentation.
#
# Every var is OPTIONAL. Unset vars fall back to the relative defaults in the
# committed config YAMLs, resolved against the pc2d/ repo root.

# --- Live pipeline (config/pipeline.yaml) ---
# Directory of a raw SemanticKITTI sequence (needs velodyne/, labels/, calib.txt, poses.txt, times.txt)
PC2D_SEQ_DIR=
# Path to the trained model checkpoint (*.pt)
PC2D_CHECKPOINT=
# Directory holding training history.jsonl for the /training dashboard page
PC2D_CKPT_DIR=

# --- Training / preprocessing (config/train_range_image.yaml) ---
# Root of raw sequences (each 00..NN containing velodyne/ + labels/)
PC2D_RAW_ROOT=
# Root where preprocessed .tar shards + meta.json live
PC2D_PROCESSED_ROOT=
