# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Local environment (machine-specific paths). Keep .env.example as the committed template.
.env
!.env.example

# Dataset / raw data (never commit; lives on F:/ or is downloaded)
data/

# Model checkpoints (delivered via Release/LFS, see Epic 1.1)
*.pt

# Eval outputs (track JSON, MD, PNG; ignore temp/large files)
results/*
!results/.gitkeep
!results/*.json
!results/*.md
!results/*.png

# Dashboard (has its own .gitignore; keep here as belt-and-suspenders)
dashboard/.next/
dashboard/node_modules/

# Absolute F:/ paths should never be referenced in committed defaults
# (not pattern-matchable; handled by config review, see Epic 0.2)
# ONNX CPU export (weights split into external *.onnx.data blob)
*.onnx
*.onnx.data

# In-browser demo branch (static-demo): committed browser assets.
# The packed demo model + sequence chunks live in dashboard/public/demo/ and
# are intentionally versioned there (self-contained Cloudflare Pages deploy).
!dashboard/public/demo/**/*.onnx
