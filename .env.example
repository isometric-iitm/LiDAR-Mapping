# Copy this file to `.env` and set paths for your machine.
# Only `.env` is gitignored; this example is committed as documentation.
#
# Every var is OPTIONAL. Unset vars fall back to the relative defaults in the
# committed config YAMLs, resolved against the pc2d/ repo root.

# --- Live pipeline (config/pipeline.yaml) ---
# Directory of a raw SemanticKITTI sequence (needs velodyne/, labels/, calib.txt, poses.txt, times.txt)
PC2D_SEQ_DIR=
# Path to the trained model checkpoint (*.pt)
PC2D_CHECKPOINT=
# Directory holding training history.jsonl for the /training dashboard page
PC2D_CKPT_DIR=
# Compute device: auto | cuda | cpu (auto = cuda if available else cpu)
PC2D_DEVICE=
# Model precision: fp32 | fp16 (fp16 casts CUDA weights to half + enables AMP)
PC2D_PRECISION=
# Playback speed multiplier for the live pipeline (float; --cpu demo uses 0.5)
PC2D_PLAYBACK_SPEED=
# torch.compile mode for the segmenter: default | reduce-overhead (unset = auto: tries default first)
PC2D_COMPILE_MODE=

# --- Live server (src/server/app.py) ---
# Comma-separated list of extra allowed CORS origins for the dashboard API
# (e.g. https://pc2d.example.com). Defaults to localhost:3000/127.0.0.1:3000.
# Cloudflare Pages deployments (*.pages.dev) are always allowed via regex.
PC2D_CORS_ORIGINS=

# --- Training / preprocessing (config/train_range_image.yaml) ---
# Root of raw sequences (each 00..NN containing velodyne/ + labels/)
PC2D_RAW_ROOT=
# Root where preprocessed .tar shards + meta.json live
PC2D_PROCESSED_ROOT=
